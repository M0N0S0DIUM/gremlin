[Unit]
Description=Gremlin AI orchestration daemon
Documentation=https://github.com/M0N0S0DIUM/gremlin
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/gremlin daemon
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=gremlin=info

# Light hardening only. Do NOT add ProtectSystem=strict / ProtectHome=read-only:
# combined with ReadWritePaths= for dirs that don't exist yet, systemd fails the
# unit with 226/NAMESPACE on every fresh install (the sandbox mount namespace is
# built BEFORE ExecStartPre runs, so nothing inside the unit can create them).
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
